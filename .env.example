# ollama = local (any pulled model). bedrock = production.
MODEL_PROVIDER=ollama

# Local Ollama. Use any tool-capable model you have pulled.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Production Amazon Bedrock. Credentials come from the standard AWS chain
# (env vars, shared config, or an IAM role). Do not put keys in this file.
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6
AWS_REGION=us-west-2

# local = sample log folder. prod = CloudWatch, Datadog, Loki, and GitHub.
# Set CONNECTORS only when production should use fewer of those systems.
APP_ENV=local
# CONNECTORS=cloudwatch,github

# Directory search_logs reads when APP_ENV=local, or when CONNECTORS includes local_logs.
# One subdirectory per service: LOG_DIR/checkout-api/api.log
LOG_DIR=examples/logs

# Production log sources. Replace the placeholder values. Leave a system blank
# and remove it from CONNECTORS if this company does not use it.
# CloudWatch uses the same AWS credential chain as Bedrock. The worker role
# needs logs:FilterLogEvents. A case for checkout-api reads PREFIX + checkout-api.
CLOUDWATCH_LOG_GROUP_PREFIX=/aws/ecs/
# Optional one-off map. Wins over the prefix for that service.
# CLOUDWATCH_LOG_GROUPS=checkout-api=/aws/lambda/checkout
CLOUDWATCH_LOOKBACK_MINUTES=60

DATADOG_SITE=datadoghq.com
DATADOG_API_KEY=replace-me
DATADOG_APP_KEY=replace-me
DATADOG_SERVICE_TAG=service
DATADOG_LOOKBACK_MINUTES=60

LOKI_URL=https://loki.example.com
LOKI_TOKEN=replace-me
LOKI_LABEL=service
LOKI_LOOKBACK_MINUTES=60

GITHUB_API_URL=https://api.github.com
GITHUB_TOKEN=replace-me
# Repository is ORG/service unless GITHUB_REPOS names it.
GITHUB_ORG=replace-me
# GITHUB_REPOS=checkout-api=acme/checkout,payments-api=acme/payments
GITHUB_LOOKBACK_HOURS=24

# Where the CLI stores a local case file. The API stores cases in Postgres.
CASE_DIR=.case

# Local Docker Compose sets this for you. Override it in production.
DATABASE_URL=postgresql+psycopg://investigator:investigator@localhost:5432/investigations

# oidc = company login (production). dev = local passwords below. Do not use dev in production.
AUTH_MODE=oidc
OIDC_ISSUER=https://login.example.com
OIDC_AUDIENCE=case-file
OIDC_CLIENT_ID=
# Optional. Defaults to the jwks_uri published by the issuer.
OIDC_JWKS_URL=
# Token claims. services is a list of service names. roles includes incident-admin for every service.
OIDC_SERVICE_CLAIM=services
OIDC_ROLE_CLAIM=roles

# Used only when AUTH_MODE=dev. The secret must be at least 16 characters.
# DEV_AUTH_SECRET=
# DEV_USERS=oncall|On-call engineer|checkout-api,payments-api|oncall-local
