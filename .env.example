# ollama = local (any pulled model). bedrock = production.
MODEL_PROVIDER=ollama

# Local Ollama. Use any tool-capable model you have pulled.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Production Amazon Bedrock. Credentials come from the standard AWS chain
# (env vars, shared config, or an IAM role). Do not put keys in this file.
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6
AWS_REGION=us-west-2

# Directory of text logs the search_logs tool reads.
LOG_DIR=examples/logs

# Where the agent stores the case file for the current investigation.
CASE_DIR=.case
